{
  "manifest_version": 3,
  "name": "LeetFair — Opt-in Contest Integrity",
  "version": "0.1.0",
  "description": "Opt-in behavioral signal capture for community-run LeetCode contests. Records paste/typing/focus metrics and submits them to the contest organizer for human triage.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.com/contest/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetFair"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
