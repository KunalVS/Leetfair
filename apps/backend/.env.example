# LeetFair backend environment (copy to .env and adjust as needed)

PORT=3000

# Leave EMPTY to use an in-memory MongoDB (zero setup, data resets on restart).
# Set to a connection string to use an external/local MongoDB instance.
MONGODB_URI=

# Contest-wide verification token prefix used to build per-user verification
# strings. Participants paste "<PREFIX>-<random>" into their LeetCode bio.
LEETFAIR_VERIFY_PREFIX=LEETFAIR

# Comma-separated usernames allowed to create contests / view moderation data.
# Empty = any user (fine for a private community league).
MODERATOR_USERNAMES=

# How long live session state is kept after the contest ends.
SESSION_TTL_SECONDS=604800

# Set to false to allow session start without bio verification (dev only).
REQUIRE_VERIFICATION=true

# Set to true to seed demo data (contest + participants + scores) at boot,
# so the dashboard has something to show immediately.
SEED_DEMO=false
